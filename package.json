{
  "name": "@keepia/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keepia design system: Carbon theme, tokens and logos of the Keepia brand",
  "license": "MIT, brand marks excepted",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepia/design-system.git"
  },
  "homepage": "https://github.com/keepia/design-system#readme",
  "bugs": {
    "url": "https://github.com/keepia/mail/issues"
  },
  "files": [
    "theme/keepia-carbon.css",
    "theme/vitepress.css",
    "theme/_index.scss",
    "theme/tokens.json",
    "fonts/*.woff2",
    "fonts/OFL.txt",
    "brand/keepia-*.svg",
    "brand/favicon*",
    "brand/icon-*.png",
    "brand/icon-maskable.svg",
    "brand/apple-touch-icon.*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./theme/keepia-carbon.css": "./theme/keepia-carbon.css",
    "./theme/vitepress.css": "./theme/vitepress.css",
    "./theme": {
      "sass": "./theme/_index.scss"
    },
    "./theme/tokens.json": "./theme/tokens.json",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build:all": "node scripts/build_all.mjs",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "peerDependencies": {
    "@carbon/styles": "^1.118.0"
  },
  "peerDependenciesMeta": {
    "@carbon/styles": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carbon/colors": "11.61.0",
    "@carbon/icons": "11.91.0",
    "@carbon/styles": "1.118.0",
    "@carbon/themes": "11.84.0",
    "@carbon/type": "11.70.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@resvg/resvg-js": "2.6.2",
    "lightningcss": "1.33.0",
    "opentype.js": "2.0.0",
    "sass": "1.106.1",
    "yaml": "2.9.1"
  }
}
